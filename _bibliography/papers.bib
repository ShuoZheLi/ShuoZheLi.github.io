@article{li2026dap,
  abbr        = {Preprint},
  title       = {Prune What the Teacher Can Repair: Distillation-Aware Pruning for LLMs},
  author      = {Li, Shuozhe and Tan, Shuhang and Ivanov, Radoslav and Liu, Leqi and Zhang, Amy},
  journal     = {Preprint},
  year        = {2026},
  selected    = {true},
  topics      = {efficiency},
  preview     = {dap.svg},
  preview_alt = {Animation: conventional pruning removes the weights with the smallest immediate damage D, while DAP removes the weights with the smallest irrecoverable damage D minus R, where R is the part the teacher can repair through distillation; after distillation the DAP student retains less damage.},
  tldr        = {Prune for post-distillation quality: remove the weights whose damage the intended teacher can repair (rank by D − R), rather than those with the least immediate damage.},
  abstract    = {This paper proposes a novel Distillation-Aware Pruning (DAP) framework for addressing the teacher–student compatibility issue in large language models (LLMs). Unlike existing approaches to teacher–student mismatch, which typically assume a predefined student and subsequently adapt the distillation objective to bridge the resulting gap, we revisit the student construction problem through pruning, which provides a natural mechanism for preserving parameters and representations from its parent teacher. Motivated by this intuition, DAP therefore prunes for post-distillation quality rather than immediate post-pruning quality by preserving what the intended distillation process cannot recover and removing what it can repair. Across settings on Qwen3-8B and DeepSeek-R1-Distill-Llama-8B, multiple tasks, and both supervised and on-policy distillation, DAP consistently produces stronger post-distillation students than both independently constructed and conventionally pruned alternatives under matched parameter and training budgets.},
  bibtex_show = {true},
}

@inproceedings{li2026gasp,
  abbr        = {NeurIPS},
  title       = {Learning Robust Reasoning through Guided Adversarial Self-Play},
  author      = {Li, Shuozhe and Tadiparthi, Vaishnav and Lee, Kwonjoon and Agarwal, Nakul and Mahjoub, Hossein Nourkhiz and Moradi Pari, Ehsan and Chen, Lizhang and Zhang, Amy and Liu, Leqi},
  booktitle   = {Advances in Neural Information Processing Systems (NeurIPS)},
  year        = {2026},
  arxiv       = {2602.00173},
  selected    = {true},
  topics      = {reasoning},
  preview     = {gasp.svg},
  preview_alt = {Animation: a single model acts as a polluter that corrupts a window of a correct reasoning trace and as an agent that must detect and repair the corruption to reach the right answer; self-generated repairs are imitated as in-distribution guidance.},
  tldr        = {One model plays two roles: a polluter that corrupts its own reasoning and an agent that learns to detect and repair the corruption, with in-distribution self-generated repairs to overcome the scarcity of successful recoveries.},
  abstract    = {Reinforcement learning from verifiable rewards (RLVR) produces strong reasoning models, yet they can fail catastrophically when the conditioning context is fallible (e.g., corrupted chain-of-thought, misleading partial solutions, or mild input perturbations), since standard RLVR optimizes final-answer correctness only under clean conditioning. We introduce GASP (Guided Adversarial Self-Play), a robustification method that explicitly trains detect-and-repair capabilities using only outcome verification. Without human labels or external teachers, GASP forms an adversarial self-play game within a single model: a polluter learns to induce failure via locally coherent corruptions, while an agent learns to diagnose and recover under the same corrupted conditioning. To address the scarcity of successful recoveries early in training, we propose in-distribution repair guidance, an imitation term on self-generated repairs that increases recovery probability while preserving previously acquired capabilities. Across four open-weight models (1.5B–8B), GASP transforms strong-but-brittle reasoners into robust ones that withstand misleading and perturbed context while often improving clean accuracy. Further analysis shows that adversarial corruptions induce an effective curriculum, and in-distribution guidance enables rapid recovery learning with minimal representational drift.},
  bibtex_show = {true},
}

@article{li2026carerft,
  abbr        = {Preprint},
  title       = {CARE-RFT: Confidence-Anchored Reinforcement Finetuning for Reliable Reasoning in Large Language Models},
  author      = {Li, Shuozhe and Cao, Jincheng and Hu, Bodun and Mokhtari, Aryan and Liu, Leqi and Zhang, Amy},
  journal     = {arXiv preprint arXiv:2602.00085},
  year        = {2026},
  arxiv       = {2602.00085},
  selected    = {true},
  topics      = {reasoning},
  preview     = {care_rft.svg},
  preview_alt = {Animation: the penalty coefficient of reverse KL grows without bound as a token's probability rises above the reference, while CARE-RFT's skew reverse KL caps it at log(1/alpha) and keeps the unbounded penalty against probability depletion; under reinforcement finetuning, no KL over-sharpens, reverse KL suppresses the reward-aligned token, and CARE-RFT lets it grow while keeping the rest of the distribution.},
  tldr        = {A drop-in replacement for the reverse-KL penalty: skew reverse KL caps the penalty on reward-aligned probability increases but keeps resisting probability depletion, retaining the reasoning gains of unconstrained RFT with calibration close to the base model.},
  abstract    = {Reinforcement finetuning (RFT) has become a central paradigm for eliciting reasoning capabilities in large language models, but it introduces a fundamental tension between capability and trustworthiness. We show that unconstrained RFT improves reasoning accuracy, but also increases hallucination and miscalibration by overly sharpening token distributions. Reverse KL (RKL) regularization alleviates this problem, but it also over-penalizes low-probability yet reward-aligned deviations, limiting reasoning gains. We propose CARE-RFT (Confidence-Anchored Regularized Reinforcement Finetuning), a drop-in replacement for standard KL regularization that introduces a direction-sensitive divergence via skew reverse KL. Unlike standard KL regularization, CARE-RFT uses a one-sided bounded constraint: it caps the penalty on reward-aligned probability increases while keeping the penalty for downward deviations unbounded. Across multiple model scales and RFT algorithms, CARE-RFT consistently matches the reasoning performance of unconstrained RFT while substantially reducing hallucination and maintaining calibration close to the base model.},
  bibtex_show = {true},
}

@inproceedings{zhou2025expo,
  abbr        = {NeurIPS},
  title       = {ExPO: Unlocking Hard Reasoning with Self-Explanation-Guided Reinforcement Learning},
  author      = {Li*, Shuozhe and Zhou*, Ruiyang and Zhang, Amy and Liu*, Leqi},
  booktitle   = {Advances in Neural Information Processing Systems (NeurIPS)},
  year        = {2025},
  arxiv       = {2507.02834},
  code        = {https://github.com/HumainLab/ExPO_rl_reasoning_by_explanation},
  selected    = {true},
  topics      = {reasoning},
  preview     = {expo.svg},
  preview_alt = {Animation: on a hard problem all of the model's own samples are wrong, so GRPO gets no signal; an expert chain-of-thought is correct but far out in the tail of the policy; ExPO conditions on the ground-truth answer to generate a self-explanation that is both likely under the policy and correct, and training on it shifts the policy toward correct reasoning.},
  tldr        = {When the model cannot yet solve a problem, let it explain the known answer: self-explanations conditioned on the ground truth are in-distribution positive samples that unlock learning where GRPO receives no signal and expert CoTs are too far off-policy.},
  abstract    = {Self-improvement via RL often fails on complex reasoning tasks because GRPO-style post-training methods rely on the model's initial ability to generate positive samples. Without guided exploration, these approaches merely reinforce what the model already knows (distribution-sharpening) rather than enabling the model to solve problems where it initially generates no correct solutions. To unlock reasoning ability in such settings, the model must explore new reasoning trajectories beyond its current output distribution. Such exploration requires access to sufficiently good positive samples to guide the learning. While expert demonstrations seem like a natural solution, we find that they are often ineffective in RL post-training. Instead, we identify two key properties of effective positive samples: they should (1) be likely under the current policy, and (2) increase the model's likelihood of predicting the correct answer. Based on these insights, we propose Self-Explanation Policy Optimization (ExPO), a simple and modular framework that generates such samples by conditioning on the ground-truth answer. It can be integrated with popular RL training methods like GRPO and DPO. ExPO enables efficient exploration and guides the model to produce reasoning trajectories more aligned with its policy than expert-written CoTs, while ensuring higher quality than its own (incorrect) samples. Experiments show that ExPO improves both learning efficiency and final performance on reasoning benchmarks, surpassing expert-demonstration-based methods in challenging settings such as MATH level-5, where the model initially struggles the most.},
  bibtex_show = {true},
}

@inproceedings{hu2025stitchllm,
  abbr        = {ACL},
  title       = {StitchLLM: Serving LLMs, One Block at a Time},
  author      = {Hu*, Bodun and Li*, Shuozhe and Agarwal, Saurabh and Lee, Myungjin and Jajoo, Akshay and Li, Jiamin and Xu, Le and Kim, Geon-Woo and Kim, Donghyun and Xu, Hong and Zhang, Amy and Akella, Aditya},
  booktitle   = {Proceedings of the 63rd Annual Meeting of the Association for Computational Linguistics (ACL)},
  pages       = {26887--26903},
  year        = {2025},
  doi         = {10.18653/v1/2025.acl-long.1305},
  html        = {https://aclanthology.org/2025.acl-long.1305/},
  selected    = {true},
  topics      = {efficiency},
  preview     = {stitchllm.svg},
  preview_alt = {Animation: a request flows through the bottom decoder blocks of a large LLM, a trained stitching layer that maps the hidden size, and the top blocks of a smaller LLM; as load rises the scheduler moves the stitch point to configurations that fit the memory budget, trading accuracy gradually instead of jumping between model sizes.},
  tldr        = {Serve LLMs at block granularity: bottom blocks of a large model are stitched to top blocks of a smaller one through a lightweight trained layer, giving fine-grained accuracy–throughput trade-offs under bursty load.},
  abstract    = {The rapid evolution of large language models (LLMs) has revolutionized natural language processing (NLP) tasks such as text generation, translation, and comprehension. However, the increasing computational demands and inference costs of these models present significant challenges. This study investigates the dynamic and efficient utilization of pre-trained weights from open-sourced LLMs of varying parameter sizes to achieve an optimal balance between computational efficiency and task performance. Drawing inspiration from the dual-process theory of human cognition, we introduce StitchLLM: a dynamic model routing framework that employs a powerful bottom model to process all queries, and uses a lightweight routing mechanism to allocate computational resources appropriately. Our novel framework optimizes efficiency and maintains performance, leveraging a trainable stitching layer for seamless integration of decoder layers across different LLMs. Experimental results demonstrate that StitchLLM improves system throughput while minimizing performance degradation, offering a flexible solution for deploying LLMs in resource-constrained settings.},
  bibtex_show = {true},
}

@inproceedings{xu2025idrl,
  abbr        = {ICLR},
  title       = {An Optimal Discriminator Weighted Imitation Perspective for Reinforcement Learning},
  author      = {Xu*, Haoran and Li*, Shuozhe and Sikchi, Harshit and Niekum, Scott and Zhang, Amy},
  booktitle   = {International Conference on Learning Representations (ICLR)},
  year        = {2025},
  arxiv       = {2504.13368},
  website     = {https://ryanxhr.github.io/IDRL/},
  selected    = {true},
  topics      = {rl},
  preview     = {idrl.svg},
  preview_alt = {Animation: in a grid world, an offline dataset contains many suboptimal transitions; Iterative Dual-RL learns the corrected visitation ratio, removes zero-weight transitions, repeats on the remaining sub-dataset, and finally behavior-clones the expert-like transitions that lead from start to goal.},
  tldr        = {Iterative Dual-RL (IDRL): offline RL as optimal discriminator-weighted imitation. Correct Dual-RL to estimate the state-action visitation ratio, iteratively drop zero-weight transitions, and behavior-clone the expert-like subset that remains.},
  abstract    = {We introduce Iterative Dual Reinforcement Learning (IDRL), a new method that takes an optimal discriminator-weighted imitation view of solving RL. Our method is motivated by a simple experiment in which we find training a discriminator using the offline dataset plus an additional expert dataset and then performing discriminator-weighted behavior cloning gives strong results on various types of datasets. That optimal discriminator weight is quite similar to the learned visitation distribution ratio in Dual-RL, however, we find that current Dual-RL methods do not correctly estimate that ratio. In IDRL, we propose a correction method to iteratively approach the optimal visitation distribution ratio in the offline dataset given no additional expert dataset. During each iteration, IDRL removes zero-weight suboptimal transitions using the learned ratio from the previous iteration and runs Dual-RL on the remaining subdataset. This can be seen as replacing the behavior visitation distribution with the optimized visitation distribution from the previous iteration, which theoretically gives a curriculum of improved visitation distribution ratios that are closer to the optimal discriminator weight. We verify the effectiveness of IDRL on various kinds of offline datasets, including D4RL datasets and more realistic corrupted demonstrations. IDRL beats strong Primal-RL and Dual-RL baselines in terms of both performance and stability, on all datasets.},
  bibtex_show = {true},
}

@inproceedings{li2026wavelsformer,
  abbr        = {ICLR-W},
  title       = {A Learnable Wavelet Transformer for Long-Short Equity Trading and Risk-Adjusted Return Optimization},
  author      = {Li*, Shuozhe and Cheng*, Du and Zhang, Amy and Liu, Leqi},
  booktitle   = {ICLR 2026 Workshops (TSALM and FinAI)},
  year        = {2026},
  arxiv       = {2601.13435},
  selected    = {true},
  topics      = {finance},
  preview     = {wavelsformer.svg},
  preview_alt = {Animation: noisy hourly returns pass through a learnable low-pass and high-pass filter bank; low-guided high-frequency injection uses attention computed from the low-frequency branch to add gated high-frequency cues; a Transformer outputs a long or short position trained directly on a risk-aware trading objective.},
  tldr        = {WaveLSFormer: a learnable wavelet front-end splits returns into low/high-frequency bands, low-guided attention injects high-frequency cues, and the model is trained end-to-end on a risk-aware trading objective instead of a forecasting loss.},
  abstract    = {Learning profitable intraday trading policies from financial time series is challenging due to heavy noise, non-stationarity, and strong cross-sectional dependence among related assets. We propose WaveLSFormer, a learnable wavelet-based long-short Transformer that jointly performs multi-scale decomposition and return-oriented decision learning. Unlike standard time-series forecasting that optimizes prediction error and typically requires a separate position-sizing or portfolio-construction step, our model directly outputs a market-neutral long/short portfolio and is trained end-to-end on a trading objective with risk-aware regularization. Specifically, a learnable wavelet front-end generates low-/high-frequency components via an end-to-end trained filter bank, guided by spectral regularizers that encourage stable and well-separated frequency bands. To fuse multi-scale information, we introduce a low-guided high-frequency injection (LGHI) module that refines low-frequency representations with high-frequency cues while controlling training stability. The model outputs a portfolio of long/short positions that is rescaled to satisfy a fixed risk budget and is optimized directly with a trading objective and risk-aware regularization. Extensive experiments on five years of hourly data across six industry groups, evaluated over ten random seeds, demonstrate that WaveLSFormer consistently outperforms MLP, LSTM and Transformer backbones, with and without fixed discrete wavelet front-ends. On average in all industries, WaveLSFormer achieves a cumulative overall strategy return of 0.607 ± 0.045 and a Sharpe ratio of 2.157 ± 0.166, substantially improving both profitability and risk-adjusted returns over the strongest baselines.},
  bibtex_show = {true},
}

@article{li2025stockformer,
  abbr        = {arXiv},
  title       = {Transformer Based Time-Series Forecasting for Stock},
  author      = {Li*, Shuozhe and Schulwolf*, Zachery B. and Miikkulainen, Risto},
  journal     = {arXiv preprint arXiv:2502.09625},
  year        = {2025},
  arxiv       = {2502.09625},
  selected    = {true},
  topics      = {finance},
  preview     = {stockformer.svg},
  preview_alt = {Animation: hourly returns of several correlated stocks in one industry enter a sliding window, a 1D-CNN embeds each time step, an encoder with ProbSparse attention and distilling halves the sequence layer by layer, and the model outputs a long or short position for the target stock trained with a profit-based loss.},
  tldr        = {Stockformer: a multivariate Transformer over correlated stocks in one industry, with 1D-CNN token embeddings, ProbSparse attention with self-attention distilling, and profit-aligned direction/tanh trading losses.},
  abstract    = {To the naked eye, stock prices are considered chaotic, dynamic, and unpredictable. Indeed, it is one of the most difficult forecasting tasks that hundreds of millions of retail traders and professional traders around the world try to do every second even before the market opens. With recent advances in the development of machine learning and the amount of data the market generated over years, applying machine learning techniques such as deep learning neural networks is unavoidable. In this work, we modeled the task as a multivariate forecasting problem, instead of a naive autoregression problem. The multivariate analysis is done using the attention mechanism via applying a mutated version of the Transformer, Stockformer, which we created.},
  bibtex_show = {true},
}

