<script>
  (function () {
    var buttons = Array.prototype.slice.call(document.querySelectorAll(".pub-filter button"));
    var items = Array.prototype.slice.call(document.querySelectorAll(".publications ol.bibliography > li"));
    var empty = document.querySelector(".pub-empty");
    var syncHash = {% if include.sync_hash %}true{% else %}false{% endif %};
    if (!buttons.length || !items.length) {
      return;
    }
    function matches(entry, filter) {
      if (filter === "all") {
        return true;
      }
      if (filter === "highlight") {
        return entry.getAttribute("data-highlight") === "1";
      }
      var topics = (entry.getAttribute("data-topics") || "").split(/\s+/);
      return topics.indexOf(filter) !== -1;
    }
    function apply(filter) {
      var shown = 0;
      items.forEach(function (li) {
        var entry = li.querySelector(".pub-entry");
        var ok = entry ? matches(entry, filter) : filter === "all";
        li.style.display = ok ? "" : "none";
        if (ok) {
          shown += 1;
        }
      });
      buttons.forEach(function (b) {
        b.setAttribute("aria-pressed", b.getAttribute("data-filter") === filter ? "true" : "false");
      });
      if (empty) {
        empty.style.display = shown ? "none" : "block";
      }
    }
    buttons.forEach(function (b) {
      b.addEventListener("click", function () {
        var f = b.getAttribute("data-filter");
        apply(f);
        if (syncHash && window.history && window.history.replaceState) {
          window.history.replaceState(null, "", "#" + f);
        }
      });
    });
    // Initial view: a filter name in the URL hash (e.g. #reasoning), a paper key
    // (e.g. #li2026gasp, scrolls to that paper), or the highlights by default.
    function fromHash() {
      var hash = decodeURIComponent((window.location.hash || "").replace("#", ""));
      var isFilter = buttons.some(function (b) {
        return b.getAttribute("data-filter") === hash;
      });
      if (isFilter) {
        apply(hash);
        return;
      }
      var target = hash ? document.getElementById(hash) : null;
      if (target) {
        var entry = target.closest(".pub-entry");
        apply(entry && entry.getAttribute("data-highlight") === "1" ? "highlight" : "all");
        setTimeout(function () {
          target.scrollIntoView({ block: "center" });
        }, 50);
        return;
      }
      apply("highlight");
    }
    if (syncHash) {
      fromHash();
      window.addEventListener("hashchange", fromHash);
    } else {
      apply("highlight");
    }
  })();
</script>
