---
layout: default
---
{%- comment -%}
  Local override of al_folio_core's about.liquid.
  Changes: lays out name, intro text and photo in a grid (desktop: text beside the photo;
  phones: a small photo above the name, then the links and the text),
  loads the publication styles, renames the publication block to
  "Selected Publications", and adds a "Community Service" section rendered
  from _data/service.yml after the publications.
{%- endcomment -%}
{% include pub_styles.liquid %}
{%- comment -%} Person / profile structured data, so search engines tie this page to the name {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "url": {{ site.url | append: site.baseurl | append: '/' | jsonify }},
    "mainEntity": {
      "@type": "Person",
      "name": {{ site.first_name | append: ' ' | append: site.last_name | jsonify }},
      "alternateName": {{ page.name_zh | jsonify }},
      "url": {{ site.url | append: site.baseurl | append: '/' | jsonify }},
      "image": {{ page.profile.image | prepend: '/assets/img/' | prepend: site.baseurl | prepend: site.url | jsonify }},
      "email": {{ site.data.socials.email | prepend: 'mailto:' | jsonify }},
      "jobTitle": "Ph.D. Student in Computer Science",
      "affiliation": { "@type": "CollegeOrUniversity", "name": "The University of Texas at Austin", "url": "https://www.utexas.edu/" },
      "alumniOf": { "@type": "CollegeOrUniversity", "name": "The University of Texas at Austin" },
      "knowsAbout": ["Reinforcement learning", "Large language models", "LLM reasoning", "Offline reinforcement learning", "Robot learning"],
      "sameAs": [
        "https://scholar.google.com/citations?user=EAth38AAAAAJ",
        "https://github.com/ShuoZheLi",
        "https://x.com/ShuozheL",
        "https://dblp.org/pid/296/3004"
      ]
    }
  }
</script>
<div class="post">
  <div class="intro-grid">
    <header class="post-header intro-name">
      <h1 class="post-title home-name">
        {{ site.first_name }} {{ site.last_name }}
        {% if page.name_zh %}<span class="zh" lang="zh">{{ page.name_zh }}</span>{% endif %}
      </h1>
      {% if page.subtitle %}<p class="desc">{{ page.subtitle }}</p>{% endif %}
    </header>
    <div class="intro-text">{{ content }}</div>
    {% if page.profile and page.profile.image %}
      <div class="intro-photo">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% if page.profile.image_circular %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
        {% else %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
        {% endif %}
        {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 641px)
      30vw, 45vw"{% endcapture %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
          cache_bust=true
        %}
      </div>
      {% if page.profile.links %}
        <p class="photo-links intro-links">{{ page.profile.links }}</p>
      {% endif %}
    {% endif %}
  </div>

  <article>
    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="home-section-title">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Highlighted papers -->
    {% if page.selected_papers %}
      <h2 class="home-section-title">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      <p class="pub-legend">
        Each animation sketches the core idea of the paper. * denotes equal contribution.
      </p>
      {% include pub_filter_bar.liquid %}
      <div class="publications">
        {% bibliography --group_by none %}
      </div>
      <p class="pub-empty">No papers in this category yet.</p>
      {% include pub_filter.liquid %}
    {% endif %}

    <!-- Community service -->
    {% if page.service and site.data.service %}
      <h2 class="home-section-title">Community Service</h2>
      <ul class="service-list">
        {% for group in site.data.service %}
          <li>
            <strong>{{ group.category }}:</strong>
            {{ group.items | join: ', ' }}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
