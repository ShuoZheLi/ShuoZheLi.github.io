---
layout: default
---
{%- comment -%}
  Local override of al_folio_core's about.liquid.
  Changes: puts the intro text in a column beside the photo (no wrapping under it),
  loads the publication styles, renames the publication block to
  "highlighted publications", and adds a "community service" section rendered
  from _data/service.yml after the publications.
{%- endcomment -%}
{% include pub_styles.liquid %}
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle %}<p class="desc">{{ page.subtitle }}</p>{% endif %}
  </header>

  <article>
    {%- comment -%}
      Intro text (everything in about.md above the "research" marker) sits in a column beside the
      photo, so it never wraps under it; everything after the marker spans the full width.
    {%- endcomment -%}
    {% assign content_parts = content | split: '<!-- research -->' %}
    <div class="intro-row">
      <div class="intro-text">{{ content_parts[0] }}</div>
      {% if page.profile and page.profile.image %}
        <div class="intro-photo">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        </div>
      {% endif %}
    </div>
    {% if content_parts.size > 1 %}
      <div class="intro-rest">{{ content_parts[1] }}</div>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 class="home-section-title">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Highlighted papers -->
    {% if page.selected_papers %}
      <h2 class="home-section-title">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">highlighted publications</a>
      </h2>
      <p class="pub-legend">
        Each animation sketches the core idea of the paper. * denotes equal contribution. See the
        <a href="{{ '/publications/' | relative_url }}">publications page</a> for the full list.
      </p>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Community service -->
    {% if page.service and site.data.service %}
      <h2 class="home-section-title">community service</h2>
      <ul class="service-list">
        {% for group in site.data.service %}
          <li>
            <strong>{{ group.category }}:</strong>
            {{ group.items | join: ', ' }}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
